{
    "headers": [
        {
            "source": "/app-config.json",
            "headers": [
                {
                    "key": "Access-Control-Allow-Origin",
                    "value": "*"
                },
                {
                    "key": "Access-Control-Allow-Headers",
                    "value": "Origin, X-Requested-With, Content-Type, Accept"
                }
            ]
        }
    ],
    "redirects": [
        {
            "source": "/:path(.+)\\.html",
            "destination": "/:path",
            "permanent": true
        }
    ],
    "rewrites": [
        {
            "source": "/((?!manifest\\.json|favicon\\.ico|robots\\.txt|img/).*)",
            "destination": "/"
        }
    ]
}